# ========================================
# WemaChat API - Environment Configuration Template
# ========================================
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the root directory
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit the `.env` file to version control
#
# Generate a new SECRET_KEY_BASE with: mix phx.gen.secret
#

# ========================================
# Server Configuration
# ========================================
PHX_SERVER=true
PORT=4000
SECRET_KEY_BASE=your-secret-key-base-here-generate-with-mix-phx-gen-secret

# ========================================
# Database Configuration
# ========================================
# For local development (PostgreSQL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=wemachat_dev
# DB_SSL=false
# DB_POOL_SIZE=3

# For production (DigitalOcean or other hosted database):
DB_HOST=your-database-host.com
DB_PORT=25060
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-database-name
DB_SSL=true
DB_POOL_SIZE=10

# ========================================
# Firebase Configuration
# ========================================
# Firebase Project Settings
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase Admin SDK service account JSON file
# Download from Firebase Console > Project Settings > Service Accounts
# Place the JSON file in the `apps/wemachat_api/priv/` directory
FIREBASE_CREDENTIALS_PATH=apps/wemachat_api/priv/your-firebase-adminsdk.json

# Firebase Web API Key
# Find in Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ========================================
# Cloudflare R2 Storage Configuration
# ========================================
# Cloudflare R2 Account ID
# Find in Cloudflare Dashboard > R2 > Overview
R2_ACCOUNT_ID=your-cloudflare-r2-account-id

# R2 API Access Key and Secret
# Generate in Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key

# R2 Bucket Name
# The name of your R2 bucket for storing media files
R2_BUCKET_NAME=your-bucket-name

# R2 Public URL
# The public URL for accessing files in your bucket
# Format: https://pub-{hash}.r2.dev
R2_PUBLIC_URL=https://pub-your-hash.r2.dev

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins for CORS
# Use "*" for development only - specify exact origins in production
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=*

# ========================================
# M-Pesa Payment Configuration (Safaricom Daraja API)
# ========================================
# M-Pesa Environment: "sandbox" for testing, "production" for live payments
# Use sandbox during development, switch to production when ready
MPESA_ENVIRONMENT=sandbox

# M-Pesa Consumer Key and Consumer Secret
# Get these from Safaricom Daraja Portal: https://developer.safaricom.co.ke/
# 1. Create an app in the portal
# 2. Copy the Consumer Key and Consumer Secret
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret

# M-Pesa Business Shortcode (Paybill or Till Number)
# For Sandbox: Use 174379 (Safaricom test shortcode)
# For Production: Use your actual Paybill/Till Number
MPESA_SHORTCODE=174379

# M-Pesa Lipa Na M-Pesa Online Passkey
# Get this from Safaricom Daraja Portal for your app
# Different passkeys for sandbox and production
MPESA_PASSKEY=your-mpesa-passkey

# M-Pesa Callback URL
# This is where Safaricom will send payment notifications
# IMPORTANT: Must be publicly accessible (no localhost)
# For local testing: Use ngrok or similar service
#   Example: ngrok http 4000
#   Then use: https://your-ngrok-id.ngrok.io/api/v1/payment/callback
# For production: Use your actual domain
#   Example: https://api.wemachat.co.ke/api/v1/payment/callback
MPESA_CALLBACK_URL=https://your-ngrok-id.ngrok.io/api/v1/payment/callback

# ========================================
# Additional Configuration (Optional)
# ========================================
# Uncomment and configure as needed:

# Enable debug mode
# DEBUG=false

# Log level (debug, info, warning, error)
# LOG_LEVEL=info

# Maximum upload file size (in MB)
# MAX_UPLOAD_SIZE=100
